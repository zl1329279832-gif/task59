<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gk.study.mapper.RecommendLogMapper">

    <select id="getRecommendStats" resultType="java.util.Map">
        select type, count(*) as count
        from b_recommend_log
        group by type
    </select>

    <select id="countByType" parameterType="java.lang.String" resultType="int">
        select count(*) from b_recommend_log where type = #{type}
    </select>

</mapper>
